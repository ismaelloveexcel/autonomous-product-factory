# API Keys (REQUIRED)
OPENAI_API_KEY=sk-...
GITHUB_TOKEN=ghp_...
VERCEL_TOKEN=...

# Database
DATABASE_URL=sqlite:///data/factory.db

# Budget & Limits
MAX_COST_PER_APP=50.0
MAX_MONTHLY_BUDGET=1000.0
MAX_CONCURRENT_BUILDS=3

# Scheduling
RESEARCH_INTERVAL_HOURS=6
HEALTH_CHECK_INTERVAL_MINUTES=15

# Safety & Compliance
MIN_AGE_TARGET=8
MAX_AGE_TARGET=25
ENABLE_COPPA_VALIDATION=true
ENABLE_CONTENT_MODERATION=true

# Performance Thresholds
MIN_DAU_FOR_SURVIVAL=10
MIN_ENGAGEMENT_RATE=0.15
KILL_AFTER_DAYS_INACTIVE=30

# GitHub Settings
GITHUB_SEARCH_LIMIT=10
GITHUB_CODE_REUSE_ENABLED=true

# OpenAI Settings
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_VISION_MODEL=gpt-4-vision-preview
OPENAI_TEMPERATURE=0.7

# Vercel Settings
VERCEL_ORG_ID=team_...
VERCEL_PROJECT_PREFIX=youthapp-

# Webhooks (Optional)
FEEDBACK_WEBHOOK_URL=https://...
ALERT_WEBHOOK_URL=https://...

# Logging
LOG_LEVEL=INFO
ENABLE_STRUCTURED_LOGGING=true
